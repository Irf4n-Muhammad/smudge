# Copy to your host's environment settings. Never commit real values.

# production = real accounts and email; demo = the local playground (default for npm run dev).
FORMA_MODE=production

# The address people type, and a second hostname for post code. Both must be https and different.
FORMA_PUBLIC_URL=https://forma.example.com
FORMA_RUNTIME_URL=https://run.forma.example.com

# Email through Resend (https://resend.com). Verify your sending domain there first.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FORMA_MAIL_FROM=Forma <hello@forma.example.com>

# Where the database lives. Must be a persistent volume.
FORMA_DATA_DIR=/data

# Port the container listens on. Most hosts set this for you.
PORT=8080

# Confirmed account emails that may use the moderation screen, comma separated.
FORMA_ADMIN_EMAILS=you@example.com

# Optional "Continue with Google". Create an OAuth client (Web application) in Google Cloud and add
# the redirect URI https://<FORMA_PUBLIC_URL host>/api/auth/google/callback. Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Header your host uses for the visitor's IP, if it sits behind a proxy (e.g. fly-client-ip,
# cf-connecting-ip). Leave empty when Forma receives connections directly.
FORMA_CLIENT_IP_HEADER=
