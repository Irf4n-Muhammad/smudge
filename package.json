{
  "name": "social-platform-foundation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "build": "npm run build:core && npm run build:web",
    "test": "npm run build:core && node --test dist/tests",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npm run build:core && node dist/scripts/demo.js",
    "dev": "node scripts/dev.mjs",
    "build:core": "tsc",
    "build:web": "next build apps/web --webpack",
    "mcp": "node scripts/mcp.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "20.17.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "prettier": "3.5.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
